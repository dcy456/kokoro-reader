{
  "name": "zotero-kokoro-reader",
  "type": "module",
  "version": "0.3.0",
  "description": "Read selected PDF text aloud in Zotero with Kokoro, a free, offline neural voice.",
  "config": {
    "addonName": "Kokoro Reader",
    "addonID": "kokoro-reader@zotero-plugin",
    "addonRef": "kokororeader",
    "addonInstance": "KokoroReader",
    "prefsPrefix": "extensions.zotero.kokororeader"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/zotero-kokoro-reader.git"
  },
  "author": "Chengyi Dong",
  "bugs": {
    "url": "https://github.com/OWNER/zotero-kokoro-reader/issues"
  },
  "homepage": "https://github.com/OWNER/zotero-kokoro-reader#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit && tsc --noEmit -p src/worker",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test --no-watch",
    "update-deps": "npm update --save",
    "test:watch": "zotero-plugin test"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
