pref-voice-title = Reading
pref-voice = Voice:
pref-preview =
    .label = Preview
pref-speed = Speed:
pref-strip-citations =
    .label = Skip citations such as [12] and (Smith et al., 2020)
pref-stop-at-references =
    .label = When reading from a position, stop at the References section
pref-preload =
    .label = Load the voice model in the background when a PDF opens (no waiting on the first read)
pref-unload = Unload the model after (minutes):
pref-unload-help = Frees the memory after this long without reading; 0 keeps the model loaded until Zotero quits.
pref-shortcut = Shortcut:
pref-shortcut-help = Reads the selected text, or stops reading. Write modifiers and a key separated by commas, e.g. alt,shift,r or accel,shift,s (accel is ⌘ on macOS, Ctrl elsewhere).
pref-model-title = Voice model
pref-dtype = Precision:
pref-dtype-fp16 =
    .label = fp16 (recommended, 163 MB)
pref-dtype-q8 =
    .label = q8 (smallest, 92 MB, slower)
pref-dtype-fp32 =
    .label = fp32 (326 MB)
pref-workers = Parallel workers:
pref-workers-help = 0 picks a value from your CPU. More workers synthesize faster but each one uses ~300 MB of memory. Takes effect the next time the model loads.
pref-mirror = Download from:
pref-model-dir = Model folder:
pref-model-status = Model:
pref-clear-cache =
    .label = Delete downloaded model
pref-model-help = The model downloads once on first use. After that, reading works offline and nothing leaves your computer. Leave the folder empty to use the Zotero data directory.
pref-help = { $name } { $version } (built { $time })
