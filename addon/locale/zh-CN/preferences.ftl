pref-voice-title = 朗读
pref-voice = 音色：
pref-preview =
    .label = 试听
pref-speed = 语速：
pref-strip-citations =
    .label = 跳过引用标记，如 [12]、(Smith et al., 2020)
pref-stop-at-references =
    .label = 从某处开始连续朗读时，读到参考文献部分就停止
pref-preload =
    .label = 打开 PDF 时在后台预先加载语音模型（第一次朗读不用等待）
pref-unload = 闲置多久后卸载模型（分钟）：
pref-unload-help = 超过这段时间没有朗读就释放内存；填 0 则一直保留到 Zotero 退出。
pref-shortcut = 快捷键：
pref-shortcut-help = 朗读选中的文字；正在朗读时按下则停止。用逗号分隔修饰键和按键，例如 alt,shift,r 或 accel,shift,s（accel 在 macOS 上是 ⌘，其他系统是 Ctrl）。
pref-model-title = 语音模型
pref-dtype = 精度：
pref-dtype-fp16 =
    .label = fp16（推荐，163 MB）
pref-dtype-q8 =
    .label = q8（最小，92 MB，较慢）
pref-dtype-fp32 =
    .label = fp32（326 MB）
pref-workers = 并行进程数：
pref-workers-help = 填 0 时根据 CPU 自动选择。进程越多合成越快，但每个约占用 300 MB 内存。下次加载模型时生效。
pref-mirror = 下载地址：
pref-model-dir = 模型文件夹：
pref-model-status = 模型：
pref-clear-cache =
    .label = 删除已下载的模型
pref-model-help = 模型只在第一次使用时下载，之后朗读完全离线，文字不会离开你的电脑。文件夹留空则使用 Zotero 数据目录。
pref-help = { $name } { $version }（构建于 { $time }）
